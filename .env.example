# PostgreSQL connection string.
DATABASE_URL="postgres://user:password@host:5432/postgres?sslmode=require"

# Signs the session JWT. Must be at least 32 characters.
# Generate one with: openssl rand -base64 32
AUTH_SECRET="replace-me-with-at-least-32-characters"

# Optional. The ngrok https URL of the visit-prediction service (ml/serve.py).
# Leave it unset: /api/visit then answers from the model bundled in src/data,
# which is what a deployed instance should do.
# ML_URL="https://xxxx.ngrok-free.app"
